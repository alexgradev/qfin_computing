              inner sep=0pt, minimum size=0.62cm}]
  % --- jury card
  \node[card] at (0,0) {};
  \node[ttl]  at (0,0) {The Jury};
  \node[body] at (0,-0.85) {7 music professionals per country\\ rank every song};
  % --- public card
  \node[card] at (7,0) {};
  \node[ttl]  at (7,0) {The Public};
  \node[body] at (7,-0.85) {millions of people at home\\ SMS, phone or online, max.\ 10 votes};
