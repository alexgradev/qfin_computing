% ---------- Slide 10: the verdict ----------
\begin{frame}{The verdict}
\centering
{\scriptsize\color{escblue}
\begin{tabular}{@{}llll@{}}
  \toprule
  Charge & Test & Result & $p$ \\
  \midrule
  Blocs favour each other & permutation (shuffle points)
    & \Sexpr{nrow(real)} of \Sexpr{nrow(real)} blocs, \Sexpr{fmt(min(real$T_obs))} to \Sexpr{fmt(max(real$T_obs))}
    & $\Sexpr{pfmt(max(real$p_holm))}$ (Holm) \\
  Control group & same & \Sexpr{fmt(ctrl$T_obs)} & \Sexpr{round(ctrl$p_value, 2)} \\
  ``Family'': juries biased too & permutation (jury points)
    & GR/CY \Sexpr{fmt(g("Greece & Cyprus", "jury_excess"))}, RO/MD \Sexpr{fmt(g("Romania & Moldova", "jury_excess"))}
    & $\Sexpr{pfmt(max(grp$p_jury_holm))}$ \\
  ``Diaspora'': public $>$ jury & swap jury/public
    & ex-YU gap \Sexpr{fmt(g("ex-Yugoslavia", "gap"))}
    & $\Sexpr{pfmt(g("ex-Yugoslavia", "p_gap_holm"))}$ \\
  Social ties explain it & QAP (shuffle countries)
    & $\rho = \Sexpr{sprintf("%.2f", rho_t)}$
    & $\Sexpr{pfmt(ties$p_value[ties$sample == "1975-2026"])}$ \\
  \bottomrule
\end{tabular}}

\vspace{0.35cm}
\pause
\colorbox{escpink}{\parbox{0.8\textwidth}{\centering\color{white}\bfseries
  Guilty of favouritism, but it is family, friendship and diaspora, not a conspiracy.}}

\vspace{0.3cm}
\pause
{\small\color{escblue}\textbf{United by politics?} \citet{ginsburgh2008} tested exactly this:
Eurovision votes follow \textbf{culture and language}, not political alliances.}

\vspace{0.25cm}
{\tiny\color{escblue!80}Caveats: correlation is not causation; distance not controlled; case-study groups chosen after seeing the data; only \Sexpr{n_split} shows since the 2016 jury/public split.}
\end{frame}




