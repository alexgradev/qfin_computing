  \node[a, anchor=north west, fill=escpink!35, text width=7.4cm] (a6)
       at ([yshift=-0.55cm]q5.south west)
       {None of the above? Fine\ldots\ 12 points $\rightarrow$ \textbf{the best song}};
  \foreach \i in {1,2,3,4,5}{\draw[arr] (q\i) -- node[lab,above]{yes} (a\i);}
  \draw[arr] (q1) -- node[lab,left]{no} (q2);
  \draw[arr] (q2) -- node[lab,left]{no} (q3);
  \draw[arr] (q3) -- node[lab,left]{no} (q4);
  \draw[arr] (q4) -- node[lab,left]{no} (q5);
  \draw[arr] (q5) -- node[lab,left]{no} (q5|-a6.north);
  \pause
  \node[right=0.9cm of a2, align=center, text width=4.6cm] (joke)
     {\textbf{\color{escblue}The song?}\\[0.15cm]
      {\Huge\color{escpink}\bfseries Optional.}};
  \pause
  \node[below=0.4cm of joke, align=center, text width=4.3cm, draw=escblue, rounded corners,
        font=\scriptsize, inner sep=4pt]
     {\textbf{Stereotype} or\\ \textbf{statistically significant fact?}};
\end{tikzpicture}
% sticker
\begin{tikzpicture}[remember picture,overlay]
  \node[rotate=12, fill=escpink, text=white, font=\large\bfseries, rounded corners=8pt,
        inner xsep=10pt, inner ysep=7pt, draw=white, line width=2pt, drop shadow]
        at ([xshift=-2.3cm,yshift=1.6cm]current page.south east)
        {Neighbour love \ding{170}};
\end{tikzpicture}
\end{frame}

