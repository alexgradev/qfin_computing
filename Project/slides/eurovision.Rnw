% ---------- Slide 6 NEW (c): excess points - how and who ----------
\begin{frame}{Excess points: who favours whom the most?}
\begin{columns}[T]
  \column{0.44\textwidth}
  {\small\color{escblue}\textbf{How we calculate it}}\\[0.2cm]
  \colorbox{escblue!8}{\parbox{0.95\linewidth}{\centering
    $e_{A\to B,t} = p_{A\to B,t} - \bar{p}^{\,(-A)}_{B,t}$\\[0.05cm]
    {\scriptsize what A gave B in show $t$, minus the average\\ B got from all \textbf{other} countries}}}\\[0.25cm]
  {\footnotesize\color{escblue}
  \begin{enumerate}
    \item[\color{escpink}\textbf{1.}] For \textbf{every vote} since 1975: points given minus what everyone else gave the same song
    \item[\color{escpink}\textbf{2.}] Average over all shows where A voted and B was on stage
    \item[\color{escpink}\textbf{3.}] Keep pairs that met \textbf{at least 10 times}
  \end{enumerate}}
  \vspace{0.1cm}
  {\scriptsize\color{escblue!80}Since 2016 jury + public points are halved, so everything is on the 12-point scale.}
  \pause
  \column{0.54\textwidth}
  {\small\color{escblue}\textbf{Top 10 directed pairs}}\\[0.15cm]
  {\scriptsize\color{escblue}
<<toppairs, results=tex>>=
top <- head(res("act1_top_pairs.csv"), 10)
top$pair <- sub("Bosnia and Herzegovina", "Bosnia \\& Herz.", top$pair)
top$pair <- sub(" -> ", " $\\\\rightarrow$ ", top$pair)
cat("\\begin{tabular}{@{}rlrr@{}}\n\\toprule\n",
    " & Pair (A $\\rightarrow$ B) & Shows & Excess \\\\\n\\midrule\n", sep = "")
cat(sprintf("%d & %s & %d & \\textbf{\\color{escpink}%s} \\\\\n",
            seq_len(nrow(top)), top$pair, top$meetings,
            formatC(top$mean_excess, format = "f", digits = 1, flag = "+")),
    sep = "")
cat("\\bottomrule\n\\end{tabular}\n")
@
  }
\end{columns}
\end{frame}

% ---------- Slide 6 NEW (d): network of strong ties (network.R) ----------
\begin{frame}{The map of friendships}
<<network_data>>=
net <- res("network_edges.csv")
@
\begin{columns}[c]
  \column{0.55\textwidth}\centering
    \includegraphics[height=0.80\textheight]{../figures/voting_network.pdf}
  \column{0.43\textwidth}
    {\small\color{escblue}
    \textbf{Arrow A $\rightarrow$ B:} A gives B on average \textbf{more than 3 excess points}
    (pairs that met at least 10 times, 1975--2026)\\[0.2cm]
    \textbf{Thicker arrow} = stronger favouritism}\\[0.4cm]
    \pause
    \colorbox{escpink}{\parbox{0.92\linewidth}{\centering\color{white}\bfseries
      \Sexpr{nrow(net)} strong ties between\\ \Sexpr{length(unique(c(net$from_code, net$to_code)))} countries}}\\[0.3cm]
    \pause
    {\small\color{escblue}
    The countries form \textbf{clusters}: Nordics, Baltics, ex-USSR, the Balkans, Greece \& Cyprus.\\[0.15cm]
    The layout algorithm \citep{fruchterman1991}, run with igraph \citep{csardi2006}, only sees the votes, \textbf{not the map}, and still draws Europe's neighbourhoods.}
\end{columns}
\end{frame}

% ---------- Slide 6d: the trial - blocs and permutation test ----------
\begin{frame}{Hypothetical blocs}
\begin{columns}[T]
  \column{0.46\textwidth}
  {\small\color{escblue}\textbf{The suspects}}\\[0.15cm]
  {\scriptsize\color{escblue}
<<suspects, results=tex>>=
nm  <- unique(votes[, c("from_code", "from_country")])
nm  <- setNames(nm$from_country, nm$from_code)
nm[c("BA", "MK")] <- c("Bosnia \\& H.", "N. Macedonia")
hist <- c("YU", "CS")                       # former states, shown as a note
b   <- blocs[order(blocs$bloc == "Control"), ]   # control group last
members <- sapply(strsplit(b$countries, " "), function(cc)
  paste(nm[setdiff(cc, hist)], collapse = ", "))
cat("\\begin{tabular}{@{}l>{\\raggedright\\arraybackslash}p{3.7cm}@{}}\n\\toprule\n")
cat(sprintf("%s & %s \\\\\n",
            ifelse(b$bloc == "Control", "\\textbf{Control}",
                   paste0("\\textbf{", gsub("&", "\\\\&", b$bloc), "}")),
            members), sep = "")
cat("\\bottomrule\n\\end{tabular}\n")
@
  }\\[0.1cm]
  {\tiny\color{escblue!80}ex-Yugoslavia also includes Yugoslavia and Serbia \& Montenegro before they split.
   Control = 4 countries with no shared border, language or history (our placebo).}
  \pause
  \column{0.52\textwidth}
  {\small\color{escblue}\textbf{Stratified Monte Carlo Permutation Test}}\\[0.15cm]
  {\footnotesize\color{escblue}
  \textbf{\color{escpink}1. Statistic:} average excess points over all $n$ votes where giver \emph{and} receiver are in the bloc (1975--2026):
  \quad $T = \frac{1}{n}\sum_{A \ne B \in \text{bloc}} e_{A\to B,t}$\\[0.2cm]
  \textbf{\color{escpink}2. Shuffle:} in every show, each country keeps its own points (12, 10, 8, \ldots, 0) but gives them to \textbf{random} songs $\Rightarrow$ $T^*$\\[0.2cm]
  \textbf{\color{escpink}3. Repeat} $B = 10{,}000$ times: this is what the bloc looks like \textbf{by chance}\\[0.2cm]
  \textbf{\color{escpink}4. Significance:}
  \quad $p = \frac{1 + \#\{b \,:\, T^*_b \ge T\}}{B + 1}$,\\[0.1cm]
  \citep{phipson2010}, then \textbf{Holm correction} \citep{holm1979} for testing \Sexpr{nrow(blocs)} blocs at once.}
\end{columns}
\end{frame}

% ---------- Slide 6b: the test in R (runs live when the slides compile) ----------
\begin{frame}[fragile]{The test in R: Greece \& Cyprus on trial}
\vspace{-0.2cm}
<<perm, echo=TRUE>>=
v <- subset(votes, year >= 1975 & vote_type == "total" & from_code != "WLD")
v$points <- ifelse(v$year >= 2016, v$points / 2, v$points)  # 12-point scale
v <- v[order(v$edition, v$from_code), ]
to   <- as.integer(factor(paste(v$edition, v$to_code)))     # song in a show
from <- as.integer(factor(paste(v$edition, v$from_code)))   # voter in a show
n_to <- tabulate(to)[to]
excess <- function(p) {                 # points minus mean of the other voters
  s <- rowsum(p, to)[to]
  p - (s - p) / (n_to - 1)
}
bloc  <- v$from_code %in% c("GR", "CY") & v$to_code %in% c("GR", "CY")
T_obs <- mean(excess(v$points)[bloc])
set.seed(2026)
T_null <- replicate(10000, {            # shuffle points within each voter
  p <- v$points[order(from, runif(nrow(v)))]
  mean(excess(p)[bloc])
})
c(T_obs = T_obs, max_null = max(T_null), p = (1 + sum(T_null >= T_obs)) / 10001)
@
\vspace{-0.15cm}
\pause
{\small\color{escblue}Best of 10{,}000 random shuffles: \Sexpr{fmt(max(T_null), 2)}. Observed value: \textbf{\color{escpink}\Sexpr{fmt(T_obs, 2)}}.}
\end{frame}

