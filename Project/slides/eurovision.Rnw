\begin{document}

% ---------- document setup ----------
\SweaveOpts{concordance=TRUE, echo=FALSE}
\fvset{fontsize=\scriptsize}

% ---------- R setup ----------
% The analysis scripts in the project folder write data/, results/ and
% figures/; the slides read those files, so no number is typed in by hand
%   build_data.R      -> data/votes.csv, data/entries.csv
%   hook.R            -> data/margins.csv
%   bloc_favoritism.R -> results/act1_blocs.csv, act1_top_pairs.csv, act1_null.rds
%   network.R         -> results/network_edges.csv, figures/voting_network.pdf
%   social_ties.R     -> results/social_ties_*.csv, figures/social_ties.pdf,
%                        figures/sci_quintiles_boxplot.pdf
% Only the Greece & Cyprus test on slide 11 is computed here, live
<<setup>>=
proj <- ".."                                   # project folder (slides/..)
res  <- function(f) read.csv(file.path(proj, "results", f))
fmt  <- function(x, d = 1) formatC(x, format = "f", digits = d, flag = "+")
pfmt <- function(p) if (p < 0.001) "< 0.001" else sprintf("= %.3f", p)  # $p \Sexpr{pfmt(.)}$

votes   <- read.csv(file.path(proj, "data", "votes.csv"))
entries <- read.csv(file.path(proj, "data", "entries.csv"))
margins <- read.csv(file.path(proj, "data", "margins.csv"))

## data overview (slide 4)
n_votes    <- format(nrow(votes), big.mark = ",")
n_shows     <- length(unique(votes$edition))
n_countries <- length(setdiff(unique(c(votes$from_code, votes$to_code)), "WLD"))
yr_votes    <- range(votes$year)

## Cyprus -> Greece stories (1998, 2005 finals; slides 6-7)
story <- function(yr) {
  f <- votes[votes$year == yr & votes$round == "final" &
             votes$vote_type == "total" & votes$to_code == "GR" &
             votes$from_code != "WLD", ]
  cy  <- f$points[f$from_code == "CY"]
  oth <- mean(f$points[f$from_code != "CY"])
  gr  <- entries[entries$year == yr & entries$round == "final" &
                 entries$country_code == "GR", ]
  list(cy = cy, oth = oth, n_oth = sum(f$from_code != "CY"),
       n_zero = sum(f$points[f$from_code != "CY"] == 0),
       exc = cy - oth, place = gr$place, total = gr$points_total)
}
s98 <- story(1998); s05 <- story(2005)

## winning margins (slide 5): finals won by less than one country's top vote
n_finals <- nrow(margins)
n_close  <- sum(margins$margin_tv < 1)

## blocs and permutation test results (slides 10, 12, 15)
blocs  <- res("act1_blocs.csv")
nullobj <- readRDS(file.path(proj, "results", "act1_null.rds"))
real    <- blocs[blocs$bloc != "Control", ]
ctrl    <- blocs[blocs$bloc == "Control", ]
bname   <- blocs$bloc
## "&" -> "\&" for LaTeX. Sweave inserts \Sexpr results with sub(), which
## removes one level of backslashes, so the string needs "\\&" here
bname   <- gsub("&", "\\\\\\\\&", bname)
## grey bars on slide 12: 99% range of the shuffled T* per bloc
lo <-apply(nullobj$T_null[, blocs$bloc], 2, quantile, 0.005)
hi <- apply(nullobj$T_null[, blocs$bloc], 2, quantile, 0.995)
## one "row/name/lo/hi/observed/colour" entry per bloc for the TikZ \foreach
bloc_tikz <- paste(sprintf("%d/%s/%.2f/%.2f/%.1f/%s", seq_along(bname) - 1,
                           bname, lo, hi, blocs$T_obs,
                           ifelse(blocs$bloc == "Control", "escblue",
                                  "escpink")), collapse = ",")

## social ties (slides 4, 13-15); q = mean excess per SCI quintile
ties  <- res("social_ties_tests.csv")
tp     <- res("social_ties_pairs.csv")
rho_t  <- ties$rho[ties$sample == "1975-2026"]
rho_16 <- ties$rho[ties$sample == "2016-2026"]
q      <- tapply(tp$excess, cut(rank(tp$sci), 5, labels = FALSE), mean)
@

