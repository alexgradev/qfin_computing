\begin{frame}{The charge: favouritism or just a good song?}
\centering
{\small Cyprus gave Greece \textbf{12 points} twice. Same score, different story:}\\[0.25cm]
\begin{tikzpicture}[y=0.14cm]
  \foreach \x/\yr/\oth/\exc/\lab/\col in {
      0/1998/0/+12/pure favouritism/escpink,
      6.4/2005/5.9/+6.1/Greece won: good song!/escblue}{
    \node[font=\large\bfseries, text=escblue] at (\x+1.6,15.5) {\yr};
    \fill[escpink] (\x+0.3,0) rectangle (\x+1.3,12);
    \fill[escblue!45] (\x+1.9,0) rectangle (\x+2.9,\oth);
    \draw[escblue, thick] (\x,0) -- (\x+3.2,0);
    \node[font=\scriptsize\bfseries, text=escpink] at (\x+0.8,13.3) {12};
    \node[font=\scriptsize\bfseries, text=escblue] at (\x+2.4,\oth+1.3) {\oth};
    \node[font=\scriptsize] at (\x+0.8,-2) {Cyprus};
    \node[font=\scriptsize, align=center] at (\x+2.4,-2.4) {everyone\\[-2pt] else (avg.)};
    \node[draw=\col, line width=1pt, rounded corners=4pt, fill=white, font=\small\bfseries,
          text=\col, align=center] at (\x+4.6,7) {excess\\ \exc};
    \node[font=\scriptsize\itshape, text=\col] at (\x+4.6,2.8) {\lab};
  }
\end{tikzpicture}

\vspace{0.2cm}
\pause
\begin{columns}[T]
  \column{0.48\textwidth}\centering
  \colorbox{escblue!8}{\parbox{0.95\linewidth}{\centering
    \textbf{\color{escblue}1. Excess points}\\[0.05cm]
    $e_{A\to B,t} = p_{A\to B,t} - \bar{p}^{\,(-A)}_{B,t}$\\[0.02cm]
    {\scriptsize what A gave B, minus what everyone else gave B}}}
  \column{0.48\textwidth}\centering
  \colorbox{escblue!8}{\parbox{0.95\linewidth}{\centering
    \textbf{\color{escblue}2. Permutation test}\\[0.05cm]
    {\footnotesize shuffle each country's points\\ \textbf{10{,}000 times}: does chance ever do this?}}}
\end{columns}

\vfill
\pause
\colorbox{escpink}{\color{white}\bfseries\ Let's put the blocs on trial.\ }
\vspace{0.2cm}
\end{frame}

