% ---------- Slide 5: does one country's vote matter? (data/margins.csv) ----------
\begin{frame}{Does one country's vote matter?}
\centering
{\small\color{escblue}\textbf{Winning margin} = winner's points $-$ runner-up's points.\\
If it is \textbf{smaller than one country's top vote}, a single country could have changed the winner.}\\[0.25cm]
\begin{columns}[T]
  \column{0.44\textwidth}\centering
    % one dot per final, close ones in pink (counts from data/margins.csv)
    \begin{tikzpicture}[scale=0.85]
      \foreach \i in {0,...,\Sexpr{n_finals - 1}}{
        \pgfmathtruncatemacro{\r}{\i/10}
        \pgfmathtruncatemacro{\c}{mod(\i,10)}
        \ifnum\i<\Sexpr{n_close}
          \fill[escpink] (\c*0.42,-\r*0.42) circle (0.15);
        \else
          \fill[escblue!20] (\c*0.42,-\r*0.42) circle (0.15);
        \fi
      }
    \end{tikzpicture}\\[0.1cm]
    {\tiny\color{escblue!70}each dot = one final \quad {\color{escpink}$\bullet$} = close final}\\[0.15cm]
    {\fontsize{30}{30}\selectfont\bfseries\color{escpink}\Sexpr{n_close}}%
    {\Large\bfseries\color{escblue}\ of \Sexpr{n_finals} finals}\\[0.15cm]
    {\small were this close}\\[0.05cm]
    {\scriptsize\color{escblue!70}(top vote: 12 points; 24 since 2016)}
  \pause
  \column{0.52\textwidth}
    {\bfseries\color{escblue}Photo finishes}\\[0.3cm]
    \begin{tikzpicture}[x=0.026cm,
        gap/.style={fill=escpink, text=white, rounded corners=6pt, font=\footnotesize\bfseries,
                    inner xsep=6pt, inner ysep=3pt}]
      \foreach \y/\yr/\w/\wp/\r/\rp/\g in {
          0/1988/Switzerland/137/United Kingdom/136/{+1 point},
          -1.7/2003/Turkey/167/Belgium/165/{+2 points}}{
        \node[anchor=west, font=\small\bfseries, text=escblue] at (0,\y) {\yr};
        \fill[escpink, rounded corners=3pt] (0,\y-0.32) rectangle (\wp,\y-0.66);
        \node[anchor=west, font=\scriptsize\bfseries, text=white] at (3,\y-0.49) {\w};
        \node[anchor=east, font=\scriptsize\bfseries, text=white] at (\wp-3,\y-0.49) {\wp};
        \fill[escblue!45, rounded corners=3pt] (0,\y-0.74) rectangle (\rp,\y-1.08);
        \node[anchor=west, font=\scriptsize\bfseries, text=white] at (3,\y-0.91) {\r};
        \node[anchor=east, font=\scriptsize\bfseries, text=white] at (\rp-3,\y-0.91) {\rp};
        \node[gap, anchor=west] at (180,\y-0.7) {\g};
      }
    \end{tikzpicture}
\end{columns}
\vfill
\pause
\centering
\colorbox{escpink}{\color{white}\bfseries\ If one vote can flip the winner, bloc voting matters.\ }
\vspace{0.3cm}
\end{frame}

% ---------- Slide 6: Cyprus -> Greece, 1998 (pure favouritism) ----------
\begin{frame}{Favouritism or just a good song?}
\centering
{\large\color{escblue}\textbf{1998 final:} Cyprus gives Greece \textbf{\color{escpink}12 points}.}\\[0.4cm]
\begin{columns}[c]
  \column{0.45\textwidth}\centering
  \begin{tikzpicture}[y=0.27cm]
    \fill[escpink] (0.4,0) rectangle (1.9,\Sexpr{s98$cy});
    \fill[escblue!45] (2.6,0) rectangle (4.1,\Sexpr{sprintf("%.2f", s98$oth)});
    \draw[escblue, thick] (0,0) -- (4.5,0);
    \node[font=\large\bfseries, text=escpink] at (1.15,\Sexpr{s98$cy}+1.2) {\Sexpr{s98$cy}};
    \node[font=\large\bfseries, text=escblue] at (3.35,\Sexpr{sprintf("%.2f", s98$oth)}+1.2) {\Sexpr{sprintf("%.0f", s98$oth)}};
    \node[font=\small] at (1.15,-1.3) {Cyprus};
    \node[font=\small, align=center] at (3.35,-1.9) {everyone else\\[-2pt] (avg.\ of \Sexpr{s98$n_oth})};
  \end{tikzpicture}
  \column{0.50\textwidth}
  {\color{escblue}
  Greece finished \textbf{\Sexpr{s98$place}th} with \textbf{\Sexpr{s98$total} points} in total.\\[0.3cm]
  \pause
  \textbf{All of them} came from Cyprus.\\
  The other \Sexpr{s98$n_oth} countries gave Greece \textbf{nothing}.}\\[0.5cm]
  \pause
  \centering
  \begin{tikzpicture}
    \node[draw=escpink, line width=1.2pt, rounded corners=5pt, fill=white,
          font=\Large\bfseries, text=escpink, align=center, inner sep=6pt]
          {excess \Sexpr{fmt(s98$exc, 0)}};
  \end{tikzpicture}\\[0.1cm]
  {\small\itshape\color{escpink}pure favouritism}
\end{columns}
\vfill
\pause
\colorbox{escpink}{\color{white}\bfseries\ So every 12 from Cyprus is favouritism? Not so fast\ldots\ }
\vspace{0.2cm}
\end{frame}

% ---------- Slide 7: Cyprus -> Greece, 2005 (good song + favouritism) ----------
\begin{frame}{Favouritism or just a good song?}
\centering
{\large\color{escblue}\textbf{2005 final:} Cyprus gives Greece \textbf{\color{escpink}12 points} again.}\\[0.4cm]
\begin{columns}[c]
  \column{0.45\textwidth}\centering
  \begin{tikzpicture}[y=0.27cm]
    \fill[escpink] (0.4,0) rectangle (1.9,\Sexpr{s05$cy});
    \fill[escblue!45] (2.6,0) rectangle (4.1,\Sexpr{sprintf("%.2f", s05$oth)});
    \draw[escblue, thick] (0,0) -- (4.5,0);
    \node[font=\large\bfseries, text=escpink] at (1.15,\Sexpr{s05$cy}+1.2) {\Sexpr{s05$cy}};
    \node[font=\large\bfseries, text=escblue] at (3.35,\Sexpr{sprintf("%.2f", s05$oth)}+1.2) {\Sexpr{sprintf("%.1f", s05$oth)}};
    \node[font=\small] at (1.15,-1.3) {Cyprus};
    \node[font=\small, align=center] at (3.35,-1.9) {everyone else\\[-2pt] (avg.\ of \Sexpr{s05$n_oth})};
    % part of Cyprus' 12 explained by the song (dashed line at the others' average)
    \draw[white, dashed, line width=1pt] (0.4,\Sexpr{sprintf("%.2f", s05$oth)}) -- (1.9,\Sexpr{sprintf("%.2f", s05$oth)});
  \end{tikzpicture}
  \column{0.50\textwidth}
  {\color{escblue}
  Greece \textbf{won} the contest with \textbf{\Sexpr{s05$total} points}.\\[0.3cm]
  \pause
  The rest of Europe liked the song too:\\
  \textbf{\Sexpr{sprintf("%.1f", s05$oth)} points} on average.}\\[0.5cm]
  \pause
  \centering
  \begin{tikzpicture}
    \node[draw=escblue, line width=1.2pt, rounded corners=5pt, fill=white,
          font=\Large\bfseries, text=escblue, align=center, inner sep=6pt]
          {excess \Sexpr{fmt(s05$exc)}};
  \end{tikzpicture}\\[0.1cm]
  {\small\itshape\color{escblue}half good song, half favouritism}
\end{columns}
\vfill
\pause
\colorbox{escpink}{\color{white}\bfseries\ Excess points = what is left once the song's quality is removed.\ }
\vspace{0.2cm}
\end{frame}

% ---------- Slide 8: excess points - formula and top 10 pairs ----------
\begin{frame}{Excess points: who favours whom the most?}
\begin{columns}[T]
  \column{0.44\textwidth}
  {\small\color{escblue}\textbf{How we calculate it}}\\[0.2cm]
  \colorbox{escblue!8}{\parbox{0.95\linewidth}{\centering
    $e_{A\to B,t} = p_{A\to B,t} - \bar{p}^{\,(-A)}_{B,t}$\\[0.05cm]
    {\scriptsize what A gave B in show $t$, minus the average\\ B got from all \textbf{other} countries}}}\\[0.25cm]
  {\footnotesize\color{escblue}
  \begin{enumerate}
    \item[\color{escpink}\textbf{1.}] For \textbf{every vote} since 1975: points given minus what everyone else gave the same song
    \item[\color{escpink}\textbf{2.}] Average over all shows where A voted and B was on stage
    \item[\color{escpink}\textbf{3.}] Keep pairs that met \textbf{at least 10 times}
  \end{enumerate}}
  \vspace{0.1cm}
  {\scriptsize\color{escblue!80}Since 2016 jury + public points are halved, so everything is on the 12-point scale.}
  \pause
  \column{0.54\textwidth}
  {\small\color{escblue}\textbf{Top 10 directed pairs}}\\[0.15cm]
  {\scriptsize\color{escblue}
<<toppairs, results=tex>>=
top <- head(res("act1_top_pairs.csv"), 10)
top$pair <- sub("Bosnia and Herzegovina", "Bosnia \\& Herz.", top$pair)
top$pair <- sub(" -> ", " $\\\\rightarrow$ ", top$pair)
cat("\\begin{tabular}{@{}rlrr@{}}\n\\toprule\n",
    " & Pair (A $\\rightarrow$ B) & Shows & Excess \\\\\n\\midrule\n", sep = "")
cat(sprintf("%d & %s & %d & \\textbf{\\color{escpink}%s} \\\\\n",
            seq_len(nrow(top)), top$pair, top$meetings,
            formatC(top$mean_excess, format = "f", digits = 1, flag = "+")),
    sep = "")
cat("\\bottomrule\n\\end{tabular}\n")
@
  }
\end{columns}
\end{frame}

% ---------- Slide 9: network of strong ties (network.R) ----------
% The figure is generated externally by network.R; the slide only includes it
\begin{frame}{The map of friendships}
<<network_data>>=
net <- res("network_edges.csv")
@
\begin{columns}[c]
  \column{0.55\textwidth}\centering
    \includegraphics[height=0.80\textheight]{../figures/voting_network.pdf}
  \column{0.43\textwidth}
    {\small\color{escblue}
    \textbf{Arrow A $\rightarrow$ B:} A gives B on average \textbf{more than 3 excess points}
    (pairs that met at least 10 times, 1975--2026)\\[0.2cm]
    \textbf{Thicker arrow} = stronger favouritism}\\[0.4cm]
    \pause
    \colorbox{escpink}{\parbox{0.92\linewidth}{\centering\color{white}\bfseries
      \Sexpr{nrow(net)} strong ties between\\ \Sexpr{length(unique(c(net$from_code, net$to_code)))} countries}}\\[0.3cm]
    \pause
    {\small\color{escblue}
    The countries form \textbf{clusters}: Nordics, Baltics, ex-USSR, the Balkans, Greece \& Cyprus.\\[0.15cm]
    The layout algorithm (Fruchterman and Reingold, 1991), run with igraph (Cs\'ardi and Nepusz, 2006), only sees the votes, \textbf{not the map}, and still draws Europe's neighbourhoods.}
\end{columns}
\end{frame}

% ---------- Slide 10: hypothetical blocs and the permutation test ----------
\begin{frame}{Hypothetical blocs}
\begin{columns}[T]
  \column{0.46\textwidth}
  {\small\color{escblue}\textbf{The suspects}}\\[0.15cm]
  {\scriptsize\color{escblue}
<<suspects, results=tex>>=
nm  <- unique(votes[, c("from_code", "from_country")])
nm  <- setNames(nm$from_country, nm$from_code)
nm[c("BA", "MK")] <- c("Bosnia \\& H.", "N. Macedonia")
hist <- c("YU", "CS")                       # former states, shown as a note
b   <- blocs[order(blocs$bloc == "Control"), ]   # control group last
members <- sapply(strsplit(b$countries, " "), function(cc)
  paste(nm[setdiff(cc, hist)], collapse = ", "))
cat("\\begin{tabular}{@{}l>{\\raggedright\\arraybackslash}p{3.7cm}@{}}\n\\toprule\n")
cat(sprintf("%s & %s \\\\\n",
            ifelse(b$bloc == "Control", "\\textbf{Control}",
                   paste0("\\textbf{", gsub("&", "\\\\&", b$bloc), "}")),
            members), sep = "")
cat("\\bottomrule\n\\end{tabular}\n")
@
  }\\[0.1cm]
  {\tiny\color{escblue!80}ex-Yugoslavia also includes Yugoslavia and Serbia \& Montenegro before they split.
   Control = 4 countries with no shared border, language or history (our placebo).}
  \pause
  \column{0.52\textwidth}
  {\small\color{escblue}\textbf{Stratified Monte Carlo Permutation Test}}\\[0.15cm]
  {\footnotesize\color{escblue}
  \textbf{\color{escpink}1. Statistic:} average excess points over all $n$ votes where giver \emph{and} receiver are in the bloc (1975--2026):
  \quad $T = \frac{1}{n}\sum_{A \ne B \in \text{bloc}} e_{A\to B,t}$\\[0.2cm]
  \textbf{\color{escpink}2. Shuffle:} in every show, each country keeps its own points (12, 10, 8, \ldots, 0) but gives them to \textbf{random} songs $\Rightarrow$ $T^*$\\[0.2cm]
  \textbf{\color{escpink}3. Repeat} $B = 10{,}000$ times: this is what the bloc looks like \textbf{by chance}\\[0.2cm]
  \textbf{\color{escpink}4. Significance:}
  \quad $p = \frac{1 + \#\{b \,:\, T^*_b \ge T\}}{B + 1}$,\\[0.1cm]
  (Phipson and Smyth, 2010), then \textbf{Holm correction} (Holm, 1979) for testing \Sexpr{nrow(blocs)} blocs at once.}
\end{columns}
\end{frame}

% ---------- Slide 11: the test for Greece & Cyprus, run live in R ----------
\begin{frame}[fragile]{The test in R: Greece \& Cyprus}
% The hidden chunk runs the test; the listings below show the same code
% (re-wrapped to fit) and the boxes print the chunk's results
<<perm, echo=FALSE, results=hide>>=
v <- subset(votes, year >= 1975 & vote_type == "total" & from_code != "WLD")
v$points <- ifelse(v$year >= 2016, v$points / 2, v$points)  # 12-point scale
v <- v[order(v$edition, v$from_code), ]
to   <- as.integer(factor(paste(v$edition, v$to_code)))     # song in a show
from <- as.integer(factor(paste(v$edition, v$from_code)))   # voter in a show
n_to <- tabulate(to)[to]
excess <- function(p) {                 # points minus mean of the other voters
  s <- rowsum(p, to)[to]
  p - (s - p) / (n_to - 1)
}
bloc  <- v$from_code %in% c("GR", "CY") & v$to_code %in% c("GR", "CY")
T_obs <- mean(excess(v$points)[bloc])
set.seed(2026)
T_null <- replicate(10000, {            # shuffle points within each voter
  p <- v$points[order(from, runif(nrow(v)))]
  mean(excess(p)[bloc])
})
c(T_obs = T_obs, max_null = max(T_null), p = (1 + sum(T_null >= T_obs)) / 10001)
@
\vspace{-0.23cm}
\begin{columns}[T,onlytextwidth]
\begin{column}{0.535\textwidth}
  {\footnotesize\bfseries\color{escblue}01 \quad Data and the excess-points statistic}\vspace{-0.05cm}
\begin{lstlisting}[style=escR]
v <- subset(votes, year >= 1975 &
  vote_type == "total" & from_code != "WLD")
v$points <- ifelse(v$year >= 2016,
  v$points / 2, v$points) # 12-point scale
v <- v[order(v$edition, v$from_code), ]
to <- as.integer(factor(
  paste(v$edition, v$to_code))) # song in show
from <- as.integer(factor(
  paste(v$edition, v$from_code))) # voter
n_to <- tabulate(to)[to]
excess <- function(p) {
  s <- rowsum(p, to)[to]
  p - (s - p) / (n_to - 1)
}
\end{lstlisting}
\end{column}
\begin{column}{0.445\textwidth}
  {\footnotesize\bfseries\color{escblue}02 \quad Permutation test (10,000 shuffles)}\vspace{-0.05cm}
\begin{lstlisting}[style=escR]
bloc <- v$from_code %in% c("GR", "CY") &
  v$to_code %in% c("GR", "CY")
T_obs <- mean(excess(v$points)[bloc])
set.seed(2026)
T_null <- replicate(10000, {
  # shuffle points within each voter
  p <- v$points[
    order(from, runif(nrow(v)))]
  mean(excess(p)[bloc])
})
c(T_obs = T_obs,
  max_null = max(T_null),
  p = (1 + sum(T_null >= T_obs)) / 10001)
\end{lstlisting}
\end{column}
\end{columns}
\vfill
\pause
\centering
\begin{tikzpicture}
  \node[draw=escpink!55,fill=escpink!7,rounded corners=5pt,
    text width=0.278\textwidth,minimum height=1.14cm,align=center,inner sep=4pt]
    at (-0.342\textwidth,0)
    {{\scriptsize\bfseries\color{escblue}OBSERVED EXCESS}\\[-1pt]
     {\LARGE\bfseries\color{escpink}\Sexpr{fmt(T_obs, 2)}}};
  \node[draw=escblue!28,fill=escblue!5,rounded corners=5pt,
    text width=0.278\textwidth,minimum height=1.14cm,align=center,inner sep=4pt]
    at (0,0)
    {{\scriptsize\bfseries\color{escblue}LARGEST SHUFFLED}\\[-1pt]
     {\LARGE\bfseries\color{escblue}\Sexpr{fmt(max(T_null), 2)}}};
  \node[draw=rcomment!50,fill=rcomment!7,rounded corners=5pt,
    text width=0.278\textwidth,minimum height=1.14cm,align=center,inner sep=4pt]
    at (0.342\textwidth,0)
    {{\scriptsize\bfseries\color{escblue}PERMUTATION $p$-VALUE}\\[-1pt]
     {\LARGE\bfseries\color{rcomment}\Sexpr{sprintf("%.4f", (1 + sum(T_null >= T_obs)) / 10001)}}};
\end{tikzpicture}
\vspace{0.04cm}
{\scriptsize\color{escblue}Observed GR--CY excess is far beyond every one of the 10,000 shuffled outcomes.}
\vspace{0.02cm}
\end{frame}

