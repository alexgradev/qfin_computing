odd_seq <- function(seq) {
if(any(!is.numeric(seq)) || any(seq %% 1 != 0) || any(seq <= 0)) {
warning("The input sequence should consist of natural numbers")
return(NaN)
}
odds_vector <- seq %% 2 != 0
return(sum(odds_vector))
}
odd_seq(numeric(0))
logstar <- function(n) {
x <- 0
if (n<=0) {
return ("log is only defined for positive numbers")
}
if (n<1) {
return (0)
}
else {
while (n>=1) {
n <- log(n)
x <- x+1
}
return(x)
}
}
logstar(123)
logstar(exp(100))
logstar(0.5)
gcd <- function(a, b) {
# signs don't change the gcd, so we just use absolute values
a <- abs(a)
b <- abs(b)
if (a == 0 && b == 0) { # gcd(0, 0) is not defined
return(NA_integer_)
}
if (b == 0) { # gcd(a, 0) = a, and we can't divide by 0 in the loop
return(a)
}
while (a %% b != 0) {
r <- a %% b
a <- b
b <- r
}
return(b)
}
gcd(20,-85)
gcd(20,0)
even_or_not <- function(n) {
result <- c()
for (i in n:1) {
i_vec <- rep(i %% 2 == 0, times = i)
result <- c(result, i_vec)
}
return(result)
}
even_or_not(3)  # should return the example output
even_or_not(4)  # should return 4 times TRUE and then ever_or_not(3)
even_or_not(-1) # NaN
even_or_not(4)  # should return 4 times TRUE and then ever_or_not(3)
