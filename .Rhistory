wilson_test <- function(n) {
if(n == 1) return(FALSE)
if(n == 2) return(TRUE)
big_number <- factorial(n) - 1
remainder  <- big_number %% n
if(remainder == 0) {
return(TRUE)
} else {
return(FALSE)
}
}
integers <- seq(2,25)
for(i in integers) {
writeLines(i, ":", wilson_test(i))
}
for(i in integers) {
cat(i, ":", wilson_test(i))
}
for(i in integers) {
cat(i, ":", wilson_test(i),"\n")
}
factorial(3)
wilson_test <- function(n) {
if(n == 1) return(FALSE)
if(n == 2) return(TRUE)
big_number <- factorial(n-1) + 1
remainder  <- big_number %% n
if(remainder == 0) {
return(TRUE)
} else {
return(FALSE)
}
}
for(i in integers) {
cat(i, ":", wilson_test(i),"\n")
}
